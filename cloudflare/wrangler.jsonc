{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azhomeinstalls-estimate",
  "main": "estimate-worker.js",
  "compatibility_date": "2026-09-30",
  "keep_vars": true,
  "routes": [
    {
      "pattern": "azhomeinstalls.com/api/estimate*",
      "zone_name": "azhomeinstalls.com"
    },
    {
      "pattern": "azhomeinstalls.com/api/admin*",
      "zone_name": "azhomeinstalls.com"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "vars": {
    "OUTBOUND_MAILING_ADDRESS": "AZHomeInstalls, 929 N Val Vista Dr, Ste 109 PMB 644, Gilbert, AZ 85234",
    "OUTBOUND_MAILBOX_APPROVED": "true",
    "OUTBOUND_PROVIDER": "gmail",
    "OUTBOUND_NEW_DAILY_CAP": "5",
    "OUTBOUND_AUTO_ENROLL_WAVE1": "true",
    "OUTBOUND_GMAIL_TESTED": "true",
    "DESTINATION_EMAIL": "cbp.cep@gmail.com",
    "FROM_EMAIL": "info@azhomeinstalls.com",
    "GOOGLE_CALENDAR_ID": "primary",
    "DEFAULT_JOB_MINUTES": "120",
    "DEFAULT_BUFFER_MINUTES": "30",
    "OUTBOUND_LAUNCH_DATE": "2026-10-06",
    "OUTBOUND_LAUNCH_EXTRA": "1"
  },
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "azhomeinstalls-leads",
      "database_id": "8cce9a83-ff34-409d-96c7-b33d1cbf134b",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "LEADS_DB",
        "database_id": "8cce9a83-ff34-409d-96c7-b33d1cbf134b"
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
